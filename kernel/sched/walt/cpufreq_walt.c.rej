+/* Global atomic for safe temperature reading in spinlock context */
+static atomic_t walt_thermal_temp = ATOMIC_INIT(0);
+
+/**
+ * walt_update_thermal_temp - External API to update governor temperature
+ * @temp: Current temperature in millidegrees Celsius
+ */
+void walt_update_thermal_temp(int temp)
+{
+	atomic_set(&walt_thermal_temp, temp);
+}
+EXPORT_SYMBOL(walt_update_thermal_temp);
+
 /************************ Governor internals ***********************/
 
+/**
+ * apply_custom_thermal_limits - Safe frequency capping based on temp
+ * Checks highest thresholds first to ensure correct capping.
+ */
+static unsigned int apply_custom_thermal_limits(struct waltgov_cpu *wg_cpu, unsigned int next_freq)
+{
+	struct waltgov_tunables *t = wg_cpu->wg_policy->tunables;
+	int temp = atomic_read(&walt_thermal_temp);
+	unsigned int target_freq = next_freq;
+
+	if (wg_cpu->cpu == 0) {
+		if (temp >= 80000 && t->cpu0temp_80) target_freq = t->cpu0temp_80;
+		else if (temp >= 70000 && t->cpu0temp_70) target_freq = t->cpu0temp_70;
+		else if (temp >= 65000 && t->cpu0temp_65) target_freq = t->cpu0temp_65;
+		else if (temp >= 60000 && t->cpu0temp_60) target_freq = t->cpu0temp_60;
+		else if (temp >= 55000 && t->cpu0temp_55) target_freq = t->cpu0temp_55;
+		else if (temp >= 45000 && t->cpu0temp_45) target_freq = t->cpu0temp_45;
+	} else if (wg_cpu->cpu == 3) {
+		if (temp >= 80000 && t->cpu3temp_80) target_freq = t->cpu3temp_80;
+		else if (temp >= 70000 && t->cpu3temp_70) target_freq = t->cpu3temp_70;
+		else if (temp >= 65000 && t->cpu3temp_65) target_freq = t->cpu3temp_65;
+		else if (temp >= 60000 && t->cpu3temp_60) target_freq = t->cpu3temp_60;
+		else if (temp >= 55000 && t->cpu3temp_55) target_freq = t->cpu3temp_55;
+		else if (temp >= 45000 && t->cpu3temp_45) target_freq = t->cpu3temp_45;
+	} else if (wg_cpu->cpu == 7) {
+		if (temp >= 80000 && t->cpu7temp_80) target_freq = t->cpu7temp_80;
+		else if (temp >= 70000 && t->cpu7temp_70) target_freq = t->cpu7temp_70;
+		else if (temp >= 65000 && t->cpu7temp_65) target_freq = t->cpu7temp_65;
+		else if (temp >= 60000 && t->cpu7temp_60) target_freq = t->cpu7temp_60;
+		else if (temp >= 55000 && t->cpu7temp_55) target_freq = t->cpu7temp_55;
+		else if (temp >= 45000 && t->cpu7temp_45) target_freq = t->cpu7temp_45;
+	}
+
+	return target_freq;
+}
