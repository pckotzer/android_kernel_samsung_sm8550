 	} else {
 		waltgov_track_cycles(wg_policy, prev_freq, curr_ws);
@@ -296,7 +383,6 @@ static unsigned int get_next_freq(struct waltgov_policy *wg_policy,
 	raw_freq = walt_map_util_freq(util, wg_policy, max, wg_driv_cpu->cpu);
