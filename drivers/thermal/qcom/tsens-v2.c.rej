--- drivers/thermal/qcom/tsens-v2.c
+++ drivers/thermal/qcom/tsens-v2.c
@@ -9,6 +9,9 @@
 #include <linux/regmap.h>
 #include "tsens.h"
 
+/* Governor API Declaration */
+extern void walt_update_thermal_temp(int temp);
+
 /* ----- SROT ------ */
 #define SROT_HW_VER_OFF	0x0000
 #define SROT_CTRL_OFF		0x0004
@@ -93,9 +96,31 @@ static const struct reg_field tsens_v2_regfields[MAX_REGFIELDS] = {
 	[TRDY] = REG_FIELD(TM_TRDY_OFF, 0, 0),
 };
 
+/**
+ * tsens_get_temp_and_push_walt - Updated to target gpuss-1.
+ * On SM8550, gpuss-1 is typically at sensor index 14.
+ */
+static int tsens_get_temp_and_push_walt(const struct tsens_sensor *s, int *temp)
+{
+	struct tsens_priv *priv = s->priv;
+	int ret;
+
+	/* Perform hardware read */
+	ret = get_temp_tsens_valid(s, temp);
+
+	/* * Target gpuss-1 (Index 14).
+	 * If pointer matches index 14, push value to governor.
+	 */
+	if (!ret && temp && s == &priv->sensor[14]) {
+		walt_update_thermal_temp(*temp);
+	}
+
+	return ret;
+}
+
 static const struct tsens_ops ops_generic_v2 = {
 	.init		= init_common,
-	.get_temp	= get_temp_tsens_valid,
+	.get_temp	= tsens_get_temp_and_push_walt,
 	.get_cold_status  = get_cold_int_status,
 	.suspend = tsens_v2_tsens_suspend,
 	.resume = tsens_v2_tsens_resume,
@@ -107,7 +132,6 @@ struct tsens_plat_data data_tsens_v2 = {
 	.fields	= tsens_v2_regfields,
 };
 
-/* Kept around for backward compatibility with old msm8996.dtsi */
 struct tsens_plat_data data_8996 = {
 	.num_sensors	= 13,
 	.ops		= &ops_generic_v2,
